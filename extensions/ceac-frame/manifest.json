{
  "manifest_version": 3,
  "name": "CP Vistos — CEAC ao lado do DS-160",
  "version": "1.1.0",
  "description": "Abre o CEAC no painel lateral do Chrome, ao lado do formulário do CP Vistos. Uso interno.",
  "permissions": ["sidePanel"],
  "host_permissions": [
    "https://www.cpvistos.com.br/*",
    "https://cpvistos.com.br/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cpvistos.com.br/*",
        "https://cpvistos.com.br/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
