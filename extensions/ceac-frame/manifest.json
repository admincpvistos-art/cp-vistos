{
  "manifest_version": 3,
  "name": "CP Vistos — CEAC ao lado do DS-160",
  "version": "1.2.0",
  "description": "Abre o CEAC como página normal sobre o quadro do DS-160 e devolve o foco ao copiar. Uso interno.",
  "permissions": ["sidePanel", "windows"],
  "host_permissions": [
    "https://www.cpvistos.com.br/*",
    "https://cpvistos.com.br/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Abrir CEAC"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cpvistos.com.br/*",
        "https://cpvistos.com.br/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
